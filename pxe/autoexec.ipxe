#!ipxe

set base-url http://${next-server}/pxe
# iPXE trusts public CAs (lan.krauzi.de's Let's Encrypt certificate) through
# cross-signed roots from ca.ipxe.org; this local mirror works offline
set crosscert ${base-url}/crosscert
set mt86p_ver 800
iseq ${buildarch} x86_64 && set mt86p_arch x86_64 ||
iseq ${buildarch} i386   && set mt86p_arch i586   ||
iseq ${buildarch} arm64  && set mt86p_arch la64   ||

set nicidx:int32 0
:nicloop
isset ${net${nicidx}/mac} || goto resume
set nloc ${net${nicidx}/busloc}
set ven  ${pci/${nloc}.0x00.2}
set dev  ${pci/${nloc}.0x02.2}
set rev  ${pci/${nloc}.0x08.1}
set cc   ${pci/${nloc}.0x09.3}
set subven ${pci/${nloc}.0x2C.2}
set subsys ${pci/${nloc}.0x2E.2}
set nicdata ${nicdata}&nics[${nicidx}][mac]=${net${nicidx}/mac:hexhyp}&nics[${nicidx}][ven]=${ven}&nics[${nicidx}][dev]=${dev}&nics[${nicidx}][rev]=${rev}&nics[${nicidx}][class]=${cc}&nics[${nicidx}][subven]=${subven}&nics[${nicidx}][subsys]=${subsys}&nics[${nicidx}][busloc]=${nloc}
inc nicidx && goto nicloop

# The machine an admin is installing / editing the Windows Live golden image on
# goes straight back to it (Windows Setup reboots unattended); anything else
# gets "exit" and continues to the menu (442-liveboot-menu.md)
:resume
chain --autofree http://${next-server}:8080/resume?mac=${mac:hexhyp}&nic=${pci/${busloc}.0x00.2}:${pci/${busloc}.0x02.2}&busloc=${busloc} ||

:start
menu Network Boot
item linux    Linux
item windows  Windows
item tools    Tools
item settings Settings
item continue <exit>
choose target && goto ${target}

:continue
exit

#
# Settings
#
:settings
menu Settings
item config       Show iPXE Config
item shell        Enter iPXE Shell
item start        <back>
choose target && goto ${target}

:config
config
goto settings

:shell
shell
goto settings

#
# Tools
#
:tools
menu Tools
goto tools_${platform}

:tools_efi
item mt86 MemTest86
iseq ${efi/SecureBoot} 00 && goto tools_pcbios || goto tools_choose

:tools_pcbios
isset mt86p_arch && item mt86p MemTest86+ ||
item clonezilla CloneZilla

:tools_choose
item start <back>
choose target && goto ${target}

:mt86
sanboot ${base-url}/tools/memtest86-usb.img
# exiting from memtest86 is actually possible
goto start

:mt86p
chain --autofree ${base-url}/tools/mt86p_${mt86p_ver}_${mt86p_arch}
# memtest86+ reboots on exit, but for good measure we go back to start
goto start

:clonezilla
kernel ${base-url}/tools/clonezilla/vmlinuz initrd=initrd.img boot=live config noswap nolocales edd=on nomodeset vga=788 nosplash noprompt fetch=${base-url}/tools/clonezilla/filesystem.squashfs
initrd ${base-url}/tools/clonezilla/initrd.img
boot

#
# Windows
#
:windows
chain --autofree http://${next-server}/pxe/win/menu.php?arch=${buildarch}&platform=${platform}&sb=${efi/SecureBoot}&uuid=${uuid}${nicdata}&boot=${mac:hexhyp}
goto start

#
# Linux
#
:linux
menu Linux
item tinycore TinyCore v17
item ubuntu Ubuntu
item thinclient ThinClient (install)
item start <back>
choose target && goto ${target}

:tinycore
iseq ${buildarch} x86_64 && set tckern vmlinuz64 || set tckern vmlinuz
iseq ${buildarch} x86_64 && set tcinit corepure64.gz || set tcinit core.gz
iseq ${buildarch} x86_64 && set tcext extensions64.gz || set tcext extensions.gz
kernel ${base-url}/tinycore/${tckern} norestore noswap desktop=flwm_topside lst=onboot_${platform}.lst
initrd ${base-url}/tinycore/${tcinit}
initrd ${base-url}/tinycore/${tcext}
initrd ${base-url}/tinycore/bootsync.sh /opt/bootsync.sh mode=755
boot

:ubuntu
kernel ${base-url}/ubuntu/linux root=/dev/ram0 ramdisk_size=1500000 ip=dhcp iso-url=http://${next-server}/pxe/ubuntu/ubuntu
initrd ${base-url}/ubuntu/initrd
boot

#
# LAN Party Thin Client
#
# The installer runs on Ubuntu's signed kernel (Microsoft -> shim -> Canonical), so it
# starts with Secure Boot on and nothing enrolled. The installed system gets its own key;
# the one-time MokManager confirmation happens when it first boots from its disk.
# Building the files: pxe/thinclient/build.sh on the server.
:thinclient
imgfree
iseq ${efi/SecureBoot} 01 && goto thinclient_sb ||
:thinclient_boot
kernel ${base-url}/thinclient/vmlinuz console=tty0 || goto thinclient_failed
initrd ${base-url}/thinclient/installer.img || goto thinclient_failed
boot || goto thinclient_failed
goto start

:thinclient_sb
shim ${base-url}/thinclient/shimx64.efi || goto thinclient_noshim
goto thinclient_boot

:thinclient_failed
echo
echo Could not start the installer. Expected ${base-url}/thinclient/vmlinuz and
echo installer.img on the server - run pxe/thinclient/build.sh there.
prompt Press any key to go back...
goto start

:thinclient_noshim
echo
echo This iPXE build has no shim support, so it cannot start a signed kernel while
echo Secure Boot is on. Turn Secure Boot off in the firmware setup instead.
prompt Press any key to go back...
goto start
